{
	"extends": "@companion-module/tools/tsconfig/node22/recommended-esm.json",
	"compilerOptions": {
		"sourceMap": true,
		"declaration": true,
		"importHelpers": true,
		"types": ["node"],
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true,
		"noUnusedLocals": false,
		"noUnusedParameters": true,
		"noImplicitAny": false,
		"strictPropertyInitialization": false,
	},
	"compileOnSave": false
}
